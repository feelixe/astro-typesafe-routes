{
  "name": "astro-typesafe-routes-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "e2e-projects/**/*"
    ],
    "catalog": {
      "astro": "^6.0.3",
      "@astrojs/check": "0.9.7",
      "typescript": "5.8.3",
      "@astrojs/node": "10.0.4",
      "valibot": "1.1.0",
      "zod": "4.3.6"
    }
  },
  "scripts": {
    "build": "bun run --filter ./packages/* build",
    "dev": "bun run --filter ./packages/* dev",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "publish": "bun publish.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/semver": "latest",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prompts": "^2.4.2",
    "semver": "latest"
  }
}
