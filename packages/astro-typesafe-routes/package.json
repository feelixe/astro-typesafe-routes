{
  "name": "astro-typesafe-routes",
  "version": "5.2.2",
  "description": "Astro Integration for typesafe URLs",
  "keywords": [
    "astro-integration"
  ],
  "homepage": "https://astro-typesafe-routes.feelixe.com",
  "bugs": {
    "url": "https://github.com/feelixe/astro-typesafe-routes/issues"
  },
  "license": "MIT",
  "author": "Felix Eklöf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feelixe/astro-typesafe-routes"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./create-route": {
      "import": "./dist/create-route.js",
      "types": "./dist/create-route.d.ts"
    },
    "./link": {
      "import": "./dist/components/link/astro/astro-link.astro"
    },
    "./link/react": {
      "import": "./dist/components/link/react/react-link.js",
      "types": "./dist/components/link/react/react-link.d.ts"
    },
    "./path": {
      "import": "./dist/path.js",
      "types": "./dist/path.d.ts"
    },
    "./standard-schema": {
      "import": "./dist/standard-schema.js",
      "types": "./dist/standard-schema.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json -w --incremental --preserveWatchOutput",
    "build": "bun build.ts",
    "lint": "oxlint --type-aware"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "astro": "catalog:",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "react": ">=18.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
